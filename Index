
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GabriPlay | Gaming & Tutorials</title>
<style>
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;background:#08090d;color:#fff;font-family:Arial,sans-serif}
header{height:75px;padding:0 8%;display:flex;align-items:center;justify-content:space-between;background:#101116;border-bottom:1px solid #292a32;position:sticky;top:0;z-index:5}
.logo{font-size:25px;font-weight:900;letter-spacing:1px}
.logo span{background:linear-gradient(90deg,#70ed58,#32d8e9,#6677ff,#db54e9,#ff5757,#ffce42);background-clip:text;color:transparent}
nav a{color:#bbb;text-decoration:none;margin-left:24px;font-size:14px}
nav a:hover{color:white}
.hero{min-height:570px;padding:120px 9%;display:flex;align-items:center;background:radial-gradient(ellipse at 80% 30%,#29204b 0%,transparent 45%),radial-gradient(ellipse at 15% 80%,#153a3b 0%,transparent 40%),#08090d}
.tag{color:#9d9eff;text-transform:uppercase;letter-spacing:4px;font-size:12px}
h1{font-size:clamp(55px,9vw,100px);margin:20px 0;letter-spacing:-5px}
h1 span{background:linear-gradient(90deg,#70ed58,#32d8e9,#6677ff,#db54e9,#ff5757,#ffce42);background-clip:text;color:transparent}
.hero p{color:#aaa;line-height:1.8;max-width:540px;font-size:17px}
.btn{display:inline-block;margin-top:20px;padding:15px 23px;border-radius:8px;background:linear-gradient(90deg,#70ed58,#32d8e9,#6677ff,#db54e9,#ff5757);color:#08090d;text-decoration:none;font-weight:bold}
section{padding:85px 9%}
.subtitle{color:#999;line-height:1.7}
h2{font-size:36px;margin:10px 0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:35px}
.card{background:#13151d;border:1px solid #292b36;border-radius:15px;padding:28px;min-height:190px;transition:.2s}
.card:hover{transform:translateY(-5px);border-color:#777}
.card .emoji{font-size:30px}
.card h3{font-size:21px}
.card p{color:#999;line-height:1.7;font-size:14px}
.banner{background:linear-gradient(120deg,#172329,#25172c);border:1px solid #333;border-radius:18px;padding:45px}
footer{padding:30px 9%;border-top:1px solid #292a32;color:#777;font-size:13px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
@media(max-width:700px){header{padding:0 5%}nav a{margin-left:10px;font-size:12px}.hero{padding:90px 7%}.cards{grid-template-columns:1fr}section{padding:65px 7%}h1{letter-spacing:-3px}}
</style>
</head>
<body>
<header>
  <div class="logo"><span>GABRIPLAY</span></div>
  <nav>
